{
    "name": "biztecheg/laravel-easy-pdf-word",
    "description": "Generate PDF and Word documents in Laravel in any language, with first-class Arabic support (RTL, shaping, numerals, tafqeet, Hijri dates) and ready-made templates.",
    "keywords": [
        "laravel",
        "pdf",
        "word",
        "docx",
        "arabic",
        "rtl",
        "mpdf",
        "invoice",
        "templates",
        "zatca"
    ],
    "homepage": "https://github.com/BiztechEG/laravel-easy-pdf-word",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "BizTech",
            "homepage": "https://github.com/BiztechEG"
        }
    ],
    "support": {
        "issues": "https://github.com/BiztechEG/laravel-easy-pdf-word/issues",
        "source": "https://github.com/BiztechEG/laravel-easy-pdf-word",
        "security": "https://github.com/BiztechEG/laravel-easy-pdf-word/security/policy"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "mpdf/mpdf": "^8.2",
        "orchestra/testbench": "^10.0|^11.0",
        "phpoffice/phpword": "^1.4",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "spatie/browsershot": "^5.4"
    },
    "suggest": {
        "mpdf/mpdf": "Default PDF engine: pure PHP, native Arabic shaping and bidi (GPL-2.0).",
        "spatie/browsershot": "Chromium PDF engine via Puppeteer, highest rendering quality.",
        "phpoffice/phpword": "Word (.docx) output: Arabic right-to-left documents and Word-designed templates.",
        "ext-intl": "Required for Hijri dates and locale-aware number formatting.",
        "ext-zip": "Required for Doc::zip()."
    },
    "autoload": {
        "psr-4": {
            "BiztechEG\\EasyPdfWord\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BiztechEG\\EasyPdfWord\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BiztechEG\\EasyPdfWord\\EasyPdfWordServiceProvider"
            ],
            "aliases": {
                "Doc": "BiztechEG\\EasyPdfWord\\Facades\\Doc"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "preview": "testbench serve --port=8000"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
